# Earnings Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# API Keys (Required)
FINNHUB_API_KEY=your_finnhub_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration (Required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_TO=recipient@example.com

# File Paths
WATCHLIST_CSV=./watchlist.csv

# OpenAI Settings (Optional)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.25

# Runtime Settings (Optional)
TEST_MODE=false
LOCAL_MODE=false

# API Rate Limiting (Optional)
API_DELAY_SECONDS=2.0

# Content Limits (Optional)
MAX_PRESS_TEXT_LENGTH=8000
MAX_GUIDANCE_LINES=8 