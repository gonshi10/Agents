# Earnings Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# API Keys (Required)
FINNHUB_API_KEY=your_finnhub_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Email Configuration (Required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_TO=recipient@example.com

# File Paths
WATCHLIST_CSV=./common/data/watchlist.csv

# Analyst Ratings Agent
# Snapshot of last-seen price targets, used to detect changes between runs.
RATINGS_PT_SNAPSHOT=./agents/ratings_agent/data/price_targets.snapshot.json

# Flights Agent
# Free Travelpayouts/Aviasales API token (Profile -> API tokens). Optional: when
# unset the flights agent is a no-op; the other agents are unaffected.
FLIGHTS_API_TOKEN=your_travelpayouts_token_here
FLIGHTS_WATCHLIST_CSV=./agents/flights_agent/data/routes.csv
# Snapshot of last-seen fares, used to detect price drops between runs.
FLIGHTS_PRICE_SNAPSHOT=./agents/flights_agent/data/prices.snapshot.json
FLIGHTS_PRICE_DROP_PCT=10
FLIGHTS_CURRENCY=usd

# Techstack Agent
# Adzuna Jobs API credentials (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
TECHSTACK_WATCHLIST_CSV=./agents/techstack_agent/data/companies.csv
# Snapshot of last-seen technology mention shares per company.
TECHSTACK_SNAPSHOT=./agents/techstack_agent/data/tech_mentions.snapshot.json
TECHSTACK_TREND_THRESHOLD=20
# Job-posting lookback window in days (monthly runs use 30).
TECHSTACK_LOOKBACK_DAYS=30

# Runtime mode
TEST_MODE=false